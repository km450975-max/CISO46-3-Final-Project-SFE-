# Copy this file to server/.env and replace the placeholder values.
# Never commit server/.env or any real secrets.

NODE_ENV=development
PORT=5000

# Local MongoDB database. Tests use an in-memory database and ignore this value.
MONGODB_URI=mongodb://127.0.0.1:27017/banana_math

# Use a long random string. Example (PowerShell):
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API with cookies.
CLIENT_ORIGIN=http://localhost:5173

# Banana Game API (University of Bedfordshire / Marc Conrad).
# Documentation: https://marcconrad.com/uob/banana/doc.php
# The live service does not require an API key. BANANA_API_KEY is optional and
# is sent only when a future deployment of the API requires one.
BANANA_API_BASE_URL=https://marcconrad.com/uob/banana/api.php
BANANA_API_MODE=live
BANANA_API_FALLBACK=false
BANANA_API_TIMEOUT_MS=8000
BANANA_API_KEY=

# bcrypt cost. Use 12 in normal use. Tests override this.
BCRYPT_ROUNDS=12

# Optional first administrator, created on startup when the email is not taken.
# Leave the password blank to skip seeding.
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Administrator

TRUST_PROXY=false

# Frontend (copy to client/.env if the API is not proxied by Vite)
# VITE_API_URL=http://localhost:5000/api/v1
