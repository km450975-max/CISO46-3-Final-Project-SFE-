{
  "info": {
    "name": "Banana Math API",
    "description": "Validates every /api/v1 endpoint. Run with Newman against a local API. Mutating requests send X-Requested-With. The cookie jar carries the session.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000/api/v1"
    },
    {
      "key": "seedAdminEmail",
      "value": "admin@school.test"
    },
    {
      "key": "seedAdminPassword",
      "value": "Admin1234"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('username')) {",
          "  const stamp = Date.now().toString().slice(-8);",
          "  pm.collectionVariables.set('username', 'pm' + stamp);",
          "  pm.collectionVariables.set('email', 'pm' + stamp + '@school.test');",
          "  pm.collectionVariables.set('password', 'Testpass1');",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Public and rejected calls",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "const payload = pm.response.json();",
                  "pm.test('success envelope', function () { pm.expect(payload.success).to.eql(true); pm.expect(payload.data).to.be.an('object'); });",
                  "pm.test('process is up', function () { pm.expect(payload.data.status).to.eql('ok'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Me without a session",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer not-a-session"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jar = pm.cookies.jar();",
                  "jar.clear(pm.request.url, function () {});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', function () { pm.response.to.have.status(401); });",
                  "const payload = pm.response.json();",
                  "pm.test('error UNAUTHENTICATED', function () { pm.expect(payload.success).to.eql(false); pm.expect(payload.error.code).to.eql('UNAUTHENTICATED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register with an empty body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', function () { pm.response.to.have.status(400); });",
                  "const payload = pm.response.json();",
                  "pm.test('error VALIDATION_ERROR', function () { pm.expect(payload.success).to.eql(false); pm.expect(payload.error.code).to.eql('VALIDATION_ERROR'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register without the browser header",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"abc\",\"email\":\"a@b.co\",\"password\":\"Testpass1\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 403', function () { pm.response.to.have.status(403); });",
                  "const payload = pm.response.json();",
                  "pm.test('error CSRF_REJECTED', function () { pm.expect(payload.success).to.eql(false); pm.expect(payload.error.code).to.eql('CSRF_REJECTED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login with a wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Requested-With",
                "value": "XMLHttpRequest"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{seedAdminEmail}}\",\"password\":\"wrong-password\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', function () { pm.response.to.have.status(401); });",
                  "const payload = pm.response.json();",
                  "pm.test('error INVALID_CREDENTIALS', function () { pm.expect(payload.success).to.eql(false); pm.expect(payload.error.code).to.eql('INVALID_CREDENTIALS'); });"
                ]
              }
            }
          ]
        }
      ]
    },
